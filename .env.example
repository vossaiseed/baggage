# Rabel departure v7 — configuration for a FUTURE server / real integrations.
# The static demo uses simulated adapters (shared/integrations/*) and reads
# window.RABEL_CONFIG instead. Never commit real secrets; copy to .env locally.

# Integration mode per adapter: simulated | live
RABEL_NUSUK_MODE=simulated
RABEL_AIRLINE_FEED_MODE=simulated
RABEL_SGS_MODE=simulated
RABEL_SMS_MODE=simulated
RABEL_MAPS_MODE=simulated
RABEL_GPS_MODE=simulated

# Live endpoints / credentials (leave empty in the demo)
RABEL_NUSUK_BASE_URL=
RABEL_NUSUK_CLIENT_ID=
RABEL_NUSUK_CLIENT_SECRET=
RABEL_AIRLINE_FEED_URL=
RABEL_AIRLINE_FEED_API_KEY=
RABEL_SGS_BASE_URL=
RABEL_SGS_API_KEY=
RABEL_SMS_PROVIDER_KEY=
RABEL_MAPS_API_KEY=

# Demo behaviour
RABEL_DEMO_OTP=123456
RABEL_DEFAULT_PIN=1234
