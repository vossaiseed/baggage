{
  "name": "rabel-hajj-baggage",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Rabel Hajj Baggage — static role apps + shared departure v7 domain layer",
  "scripts": {
    "dev": "http-server . -p 5173 -c-1 --silent",
    "lint": "eslint shared tests scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "node scripts/build-check.mjs",
    "seed:departure": "node scripts/seed-departure.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run seed:departure"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "http-server": "^14.1.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
